{
  "name": "gladys-here-travel-time",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for travel times with live traffic from the HERE Routing, Public Transit and Geocoding APIs: one device per trip (car, truck, scooter, bicycle, walking, public transport), traffic delay, distance, route, scene triggers and actions, dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-here-travel-time",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-here-travel-time.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "here",
    "here-routing",
    "travel-time",
    "traffic",
    "public-transport",
    "home-automation"
  ]
}
